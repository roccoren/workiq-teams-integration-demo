# ===== WorkIQ Demo configuration =====
# Mode: auto | live | mock  (auto = use live CLI when available, else mock)
WORKIQ_MODE=auto

# Live mode: command used to invoke the WorkIQ CLI.
# Default resolution: ./node_modules/.bin/workiq -> PATH -> npx -y @microsoft/workiq
# WORKIQ_CLI=npx -y @microsoft/workiq
# Account email for --account (uses the CLI's cached credentials)
# WORKIQ_ACCOUNT=you@contoso.com
#
# Per-user delegation (每个用户用自己的权限查自己的数据):
#   - List every account that has completed "workiq auth login --account <email>" once
#     on this machine (first one is the default):
#   WORKIQ_ACCOUNTS=alice@contoso.com,bob@contoso.com
#   - Map Teams users to accounts (keys: Teams user id / aadObjectId / name / email):
#   ACCOUNT_MAP_FILE=account-map.json
#   # account-map.json: { "alice@contoso.com": "alice@contoso.com", "<aadObjectId>": "bob@contoso.com" }
#   - Optional: protect the self-service enroll API (POST /api/enroll) with a token.
#     The web UI then needs the token too — pass it as ?token= or x-enroll-token.
#   ENROLL_TOKEN=change-me
# Per-query timeout for the live CLI (ms)
WORKIQ_TIMEOUT_MS=180000

# Web server
PORT=3000

# ===== Teams bot (optional; the app also runs without it) =====
# Register a bot at https://portal.azure.com -> Azure Bot to get these
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# Teams app manifest placeholders (scripts/generate-manifest.mjs)
TEAMS_APP_ID=
TEAMS_BOT_ID=
TEAMS_APP_NAME=WorkIQ Query Assistant

# ===== Public URL (Teams tab / task module use this as their content base) =====
# External https base URL of this app, no trailing slash. Set automatically by
# the Azure deployment (scripts/deploy-azure.mjs); locally use your tunnel URL.
# PUBLIC_URL=https://workiq-demo.eastasia.azurecontainerapps.io

# ===== Split topology: run the engine elsewhere (see docs/AZURE.md) =====
# When set, this process never spawns the WorkIQ CLI; it forwards /api/ask,
# /api/chat, /api/retrieve … to the engine host that owns the token caches.
# ENGINE_API_URL=https://engine-host.internal

# ===== Azure deployment (scripts/deploy-azure.mjs; env-only, not read by the app) =====
# AZ_SUBSCRIPTION=<subscription id>          # default: current az context
# RESOURCE_GROUP=workiq-demo-rg
# LOCATION=eastasia
# APP_NAME=workiq-demo                        # container app + image name
# BOT_NAME=workiq-query-bot                   # Azure Bot resource whose endpoint gets updated
# BOT_RESOURCE_GROUP=workiq-demo-rg
# IMAGE_TAG=v20260817120000                   # default: timestamp
# SKIP_BUILD=1                                # redeploy without rebuilding the image