# 新租户部署参数模板 —— 复制成 .env.<别名> 后填写，再跑：
#   az login --tenant <TARGET_TENANT_ID>
#   node scripts/onboard-tenant.mjs .env.<别名>
#
# 这个文件本身不含机密：client secret 由脚本生成并写进 BOT_ENV_FILE（默认 .env.bot.<别名>，权限 600）。

# ---- 必填 ----
TARGET_TENANT_ID=00000000-0000-0000-0000-000000000000
AZ_SUBSCRIPTION=00000000-0000-0000-0000-000000000000
APP_NAME=workiq-demo                 # 容器应用名 + 镜像名，小写字母/数字/连字符，3-24 位，租户内唯一

# ---- 命名与位置（可选，有默认值）----
TENANT_ALIAS=contoso                 # 只用于文件名（凭据文件 / 应用包），默认取 APP_NAME
RESOURCE_GROUP=workiq-demo-rg        # 默认 <APP_NAME>-rg
LOCATION=westus2
BOT_NAME=workiq-demo-bot             # 默认 <APP_NAME>-bot
BOT_ENV_FILE=.env.bot.contoso        # 默认 .env.bot.<TENANT_ALIAS>
TEAMS_APP_ZIP=teams/workiq-demo.zip  # 默认 teams/<APP_NAME>.zip

# ---- 行为开关 ----
BOT_APP_TYPE=SingleTenant            # SingleTenant（只服务本租户）| MultiTenant（跨租户，每个租户仍需各自同意）
WORKIQ_MODE=mock                     # mock：匿名走示例数据；带 Teams SSO 的请求始终走真实 Work IQ
PERSIST_HOME=0                       # 1 才挂 Azure Files；订阅策略禁用存储共享密钥时必须为 0
OAUTH_CONNECTION_NAME=workiq         # Azure Bot 的 OAuth 连接名（bot 侧 SSO）
# BILLING_POLICY_READY=1            # 在 admin.cloud.microsoft 已激活 “Work IQ API” Copilot Credits 策略后才设 1
CONSENT=1                            # 1 = 自动授予 WorkIQAgent.Ask 的管理员同意
# TEAMS_APP_ID=                      # 复用已有 Teams 应用 id 时填；留空则每次生成新 GUID
# TEAMS_APP_VERSION=1.0.0            # 覆盖已上架的同 id 应用时必须递增
# TEAMS_APP_NAME=WorkIQ Query Assistant
# BOT_APP_ID=                        # 复用已有 App Registration 时填（配合 BOT_APP_SECRET 或 BOT_ENV_FILE）
